.title{text-align:center;font-size:32px;margin-bottom:35px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:#101827;border:1px solid #243044;border-radius:18px;padding:25px}
.card h3{color:#ffd43b;margin-bottom:12px}
.card p{color:#b7c1d0;line-height:1.8}
.stock{display:flex;gap:20px;flex-wrap:wrap;justify-content:center}
.stock div{background:#101827;border-radius:16px;padding:20px;width:220px;border:1px solid #263447}
.stock strong{display:block;font-size:28px;color:#00ff88;margin-top:15px}
.cta{text-align:center;padding:80px 20px;background:#07131d}
footer{text-align:center;padding:30px;color:#64748b}
.fixed{position:fixed;bottom:15px;left:50%;transform:translateX(-50%);background:#00d95f;color:#fff;padding:15px 40px;border-radius:50px;text-decoration:none;font-weight:bold}
@media(max-width:800px){h1{font-size:32px}.stats{flex-direction:column;gap:20px}.grid{grid-template-columns:1fr}}
